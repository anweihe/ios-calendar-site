---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureIcon from "./FeatureIcon.astro";
import { pagePath, sitePath as asset, type Language } from "../i18n/routes";
import { translations } from "../i18n/translations";

interface Props { lang: Language; }
const { lang } = Astro.props;
const { common, home: t } = translations[lang];
const capture = (name: string) => asset(`/screenshots/${lang}/${name}.png`);
const store = lang === "de"
  ? "https://apps.apple.com/de/app/month-atlas/id6829733469"
  : "https://apps.apple.com/us/app/month-atlas/id6829733469";
const coreIcons = ["calendar", "edit", "sliders"];
const newIcons = ["search", "bell", "holiday", "panel", "language"];
---

<BaseLayout title={t.title} description={t.description} lang={lang} page="home">
  <section id="product_intro" class="hero site-shell min-h-[42rem] py-16 lg:py-24">
    <div class="hero-content grid w-full max-w-none gap-14 px-0 lg:grid-cols-[1fr_0.78fr] lg:items-center">
      <div class="max-w-2xl">
        <div class="badge badge-outline border-primary/40 text-primary mb-6 gap-2 px-3 py-3 font-semibold">{t.badge}</div>
        <div class="mb-7 flex items-center gap-5">
          <img class="brand-mark size-20 rounded-[1.4rem] sm:size-24" src={asset("/app-icon.png")} width="96" height="96" alt={t.iconAlt} />
          <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">{t.category}</p>
        </div>
        <h1 class="text-5xl leading-[0.98] font-extrabold tracking-[-0.055em] sm:text-7xl">Month Atlas</h1>
        <p class="mt-7 max-w-xl text-xl leading-relaxed font-medium sm:text-2xl">{t.tagline}</p>
        <p class="text-base-content/70 mt-5 max-w-xl text-base leading-relaxed sm:text-lg">{t.pitch}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="bg-primary text-primary-content inline-flex min-h-12 items-center justify-center rounded-xl px-5 py-3 font-semibold" href={store}>{common.download}</a>
          <a class="border-base-300 bg-base-100 inline-flex min-h-12 items-center justify-center rounded-xl border px-5 py-3 font-semibold" href="#calendar_workflow">{common.discover}</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[25rem]">
        <div class="bg-primary/10 absolute inset-8 -z-10 rounded-[3rem] blur-3xl" aria-hidden="true"></div>
        <img class="phone-shot h-auto w-full rounded-[1.65rem]" src={capture("month-overview")} width="1320" height="2868" alt={t.monthAlt} fetchpriority="high" />
      </div>
    </div>
  </section>

  <section id="calendar_workflow" class="bg-base-200/65 border-base-300 border-y py-20 sm:py-24" aria-labelledby="funktionen">
    <div class="site-shell">
      <div class="max-w-2xl">
        <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">{t.featuresLabel}</p>
        <h2 id="funktionen" class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">{t.featuresTitle}</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {t.coreFeatures.map((feature, index) => (
          <article class="card border-base-300 bg-base-100 border shadow-sm">
            <div class="card-body gap-4 p-7">
              <div class="bg-primary/10 text-primary grid size-12 place-items-center rounded-2xl" aria-hidden="true">
                <FeatureIcon icon={coreIcons[index]} />
              </div>
              <h3 class="card-title text-xl">{feature.title}</h3>
              <p class="text-base-content/70 leading-relaxed">{feature.text}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 max-w-2xl">
        <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">{t.additionsLabel}</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{t.additionsTitle}</h2>
        <p class="text-base-content/70 mt-4 leading-relaxed">{t.additionsIntro}</p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {t.additions.map((feature, index) => (
          <article class="card border-base-300 bg-base-100 border shadow-sm">
            <div class="card-body gap-4 p-7">
              <div class="bg-primary/10 text-primary grid size-12 place-items-center rounded-2xl" aria-hidden="true">
                <FeatureIcon icon={newIcons[index]} />
              </div>
              <h3 class="card-title text-xl">{feature.title}</h3>
              <p class="text-base-content/70 leading-relaxed">{feature.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="adaptive_display" class="site-shell py-20 sm:py-24" aria-labelledby="display-title">
    <h2 id="display-title" class="text-3xl font-bold tracking-tight sm:text-5xl">{t.displayTitle}</h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {[
        { image: "adaptive-month", title: t.adaptiveTitle, text: t.adaptiveText, alt: t.adaptiveAlt },
        { image: "dark-month", title: t.darkTitle, text: t.darkText, alt: t.darkAlt },
      ].map((view) => (
        <figure class="card border-base-300 bg-base-200/65 border">
          <div class="px-7 pt-8">
            <img class="phone-shot mx-auto h-auto w-full max-w-64 rounded-[1.65rem]" src={capture(view.image)} width="1320" height="2868" loading="lazy" alt={view.alt} />
          </div>
          <figcaption class="card-body gap-4 p-7">
            <h3 class="card-title text-xl">{view.title}</h3>
            <p class="text-base-content/70 leading-relaxed">{view.text}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section id="practical_questions" class="site-shell pb-4" aria-labelledby="questions-title">
    <h2 id="questions-title" class="text-3xl font-bold tracking-tight sm:text-5xl">{t.questionsTitle}</h2>
    <div class="mt-8 max-w-3xl">
      {t.questions.map((item, index) => (
        <details class="question border-base-300 border-b" open={index === 0}>
          <summary>{item.question}<span class="disclosure-mark" aria-hidden="true"></span></summary>
          <div class="text-base-content/70 pb-6 leading-relaxed">
            <p>{item.answer}</p>
            {item.privacy && <a class="link link-primary mt-3 inline-flex min-h-11 items-center" href={pagePath("privacy", lang)}>{t.readPrivacy}</a>}
          </div>
        </details>
      ))}
      <p class="mt-8">{t.anotherQuestion} <a class="link link-primary inline-flex min-h-11 items-center" href="mailto:andre@andreweihe.de">{common.contact}</a></p>
    </div>
  </section>
</BaseLayout>
