---
interface Props { icon: string; }
const { icon } = Astro.props;
---
<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
  {icon === "calendar" && <>
    <path d="M6 3v3m12-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" />
    <path d="M8 13h2m4 0h2m-8 4h2m4 0h2" />
  </>}
  {icon === "edit" && <path d="M14.5 5.5 18.5 9.5M4 20l3.5-.8L19 7.7a1.5 1.5 0 0 0 0-2.1l-.6-.6a1.5 1.5 0 0 0-2.1 0L4.8 16.5 4 20Z" />}
  {icon === "sliders" && <>
    <path d="M4 6h9m4 0h3M4 12h3m4 0h9M4 18h9m4 0h3" />
    <circle cx="15" cy="6" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="15" cy="18" r="2" />
  </>}
  {icon === "search" && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></>}
  {icon === "bell" && <><path d="M6 10a6 6 0 0 1 12 0v5l2 3H4l2-3v-5Zm4 11h4" /><path d="M12 2v2" /></>}
  {icon === "holiday" && <><path d="M6 3v3m12-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" /><path d="m8 14 3 3 5-5" /></>}
  {icon === "panel" && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 13h18m-11 4h4" /></>}
  {icon === "language" && <><circle cx="12" cy="12" r="9" /><ellipse cx="12" cy="12" rx="4" ry="9" /><path d="M3 12h18" /></>}
</svg>
