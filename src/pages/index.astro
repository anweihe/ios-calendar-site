---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (name: string) => `${base}/${name}`;

const features = [
  {
    title: "Monatsansicht",
    text: "Der ganze Monat mit Kalenderwochen, mehrtägigen Terminen und genau so vielen Wochenzeilen wie nötig.",
    icon: "calendar",
  },
  {
    title: "Termine bearbeiten",
    text: "Termine direkt erstellen, ansehen, ändern oder löschen – einschließlich Wiederholungen und Erinnerungen.",
    icon: "edit",
  },
  {
    title: "Kalender anpassen",
    text: "Kalender ein- und ausblenden, Farben wählen und die Darstellung an deinen Monat anpassen.",
    icon: "sliders",
  },
];
---

<BaseLayout
  title="Month Atlas – Dein Monat auf einen Blick"
  description="Month Atlas ist eine übersichtliche Monatskalender-App für iPhone ab iOS 17."
>
  <section class="hero site-shell min-h-[42rem] py-16 lg:py-24">
    <div class="hero-content grid w-full max-w-none gap-14 px-0 lg:grid-cols-[1fr_0.78fr] lg:items-center">
      <div class="max-w-2xl">
        <div class="badge badge-outline border-primary/40 text-primary mb-6 gap-2 px-3 py-3 font-semibold">
          Für iPhone ab iOS 17
        </div>
        <div class="mb-7 flex items-center gap-5">
          <img
            class="brand-mark size-20 rounded-[1.4rem] sm:size-24"
            src={asset("app-icon.png")}
            width="96"
            height="96"
            alt="App-Icon von Month Atlas"
          />
          <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">Monatskalender</p>
        </div>
        <h1 class="text-5xl leading-[0.98] font-extrabold tracking-[-0.055em] sm:text-7xl">Month Atlas</h1>
        <p class="mt-7 max-w-xl text-xl leading-relaxed font-medium sm:text-2xl">
          Dein ganzer Monat. Klar, schnell und ohne Umwege.
        </p>
        <p class="text-base-content/70 mt-5 max-w-xl text-base leading-relaxed sm:text-lg">
          Eine fokussierte Kalender-App für alle, die Termine lieber im Zusammenhang sehen als in einzelnen Listen.
        </p>
      </div>

      <div class="relative mx-auto w-full max-w-[25rem]">
        <div class="bg-primary/10 absolute inset-8 -z-10 rounded-[3rem] blur-3xl" aria-hidden="true"></div>
        <img
          class="phone-shot h-auto w-full rounded-[1.65rem]"
          src={asset("month-atlas-screenshot.png")}
          width="1320"
          height="2868"
          alt="Month Atlas zeigt den November 2026 als vollständige Monatsansicht."
        />
      </div>
    </div>
  </section>

  <section class="bg-base-200/65 border-base-300 border-y py-20 sm:py-24" aria-labelledby="funktionen">
    <div class="site-shell">
      <div class="max-w-2xl">
        <p class="text-primary text-sm font-bold tracking-[0.16em] uppercase">Auf das Wesentliche konzentriert</p>
        <h2 id="funktionen" class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">Ein Kalender. Ein Monat. Alles da.</h2>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          features.map((feature) => (
            <article class="card border-base-300 bg-base-100 border shadow-sm">
              <div class="card-body gap-4 p-7">
                <div class="bg-primary/10 text-primary grid size-12 place-items-center rounded-2xl" aria-hidden="true">
                  {feature.icon === "calendar" && (
                    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M6 3v3m12-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" />
                      <path d="M8 13h2m4 0h2m-8 4h2m4 0h2" />
                    </svg>
                  )}
                  {feature.icon === "edit" && (
                    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M14.5 5.5 18.5 9.5M4 20l3.5-.8L19 7.7a1.5 1.5 0 0 0 0-2.1l-.6-.6a1.5 1.5 0 0 0-2.1 0L4.8 16.5 4 20Z" />
                    </svg>
                  )}
                  {feature.icon === "sliders" && (
                    <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M4 6h9m4 0h3M4 12h3m4 0h9M4 18h9m4 0h3" />
                      <circle cx="15" cy="6" r="2" /><circle cx="9" cy="12" r="2" /><circle cx="15" cy="18" r="2" />
                    </svg>
                  )}
                </div>
                <h3 class="card-title text-xl">{feature.title}</h3>
                <p class="text-base-content/70 leading-relaxed">{feature.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

</BaseLayout>
